{
  "name": "podia.dev",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Open-source competitive intelligence archive and discovery engine for past hackathon winning projects.",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "seed": "cd backend && python -m app.seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}

